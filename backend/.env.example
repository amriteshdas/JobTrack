# Copy this file to `.env` in the same directory and fill in real values.
# `.env` itself is gitignored and must never be committed.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# PostgreSQL
DATABASE_NAME=jobtrack
DATABASE_USER=jobtrack_user
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# CORS (comma-separated list, no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Only required when DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=yourdomain.com
